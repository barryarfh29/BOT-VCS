# ============================================================
# BOT-VCS Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Telegram API (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456:ABCdefGHIjklMNO

# MongoDB Connection URI
MONGO_URI=mongodb+srv://user:password@cluster.example.net/?appName=MyApp

# Payment Gateway
PAYMENT_API_URL=https://botpayment.site/api/v1
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET=your_payment_secret

# Base URL — "tanam" domain/IP di sini
# Frontend connect ke URL ini. Ganti VPS? Cukup ganti value ini.
# Contoh: http://IP_VPS:8080 atau https://admin.yourdomain.com
BASE_URL=http://localhost:8080

# Allowed CORS origins (comma-separated, kosong = hanya BASE_URL)
# Contoh: http://localhost:3000,https://admin.yourdomain.com
ALLOWED_ORIGINS=

# API Secret untuk web admin dashboard (generate random string)
API_SECRET=your_random_secret_here

# API Server port
API_PORT=8080

# Rate limiting (requests per IP per window)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Video storage folder
VIDEO_FOLDER=videos

# Log file
LOG_FILE=bot.log
